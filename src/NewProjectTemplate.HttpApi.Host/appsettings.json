{
  "App": {
    "SelfUrl": "https://localhost:44307",
    "AngularUrl": "http://localhost:4200",
    "CorsOrigins": "https://*.example.com,https://example.com,http://localhost:4200,",
    "RedirectAllowedUrls": "https://*.example.com,https://example.com,http://localhost:4200,",
    "TenantDomainFormat": "{0}.example.com",
    "TenantWildcardDomainFormat": "https://{0}.example.com",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
